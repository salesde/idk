# ============================================================
# AI COMPANY — Environment Configuration
# Copy to .env and fill in your keys before running.
# ============================================================

# ---- LLMs -----------------------------------------------
# Anthropic Claude (executives only — used sparingly)
ANTHROPIC_API_KEY=

# Google Gemini (primary model for all workers + research)
GOOGLE_API_KEY=

# ---- Research Tools ------------------------------------
# Tavily search (free tier: 1000 searches/month)
# Get key at: https://tavily.com
TAVILY_API_KEY=

# ---- TikTok --------------------------------------------
# Apply at: https://developers.tiktok.com
# NOTE: Content Posting API requires TikTok app approval
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- YouTube -------------------------------------------
# Create credentials at: https://console.cloud.google.com
# Enable "YouTube Data API v3"
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# After first OAuth flow, this will be auto-populated:
YOUTUBE_REFRESH_TOKEN=

# ---- Netlify (Website/SEO deployment) ------------------
# Get token at: https://app.netlify.com/user/applications
NETLIFY_AUTH_TOKEN=
NETLIFY_TEAM_ID=

# ---- Shopify (Dropshipping) ----------------------------
# Create a private app in your Shopify admin
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# ---- Company Configuration -----------------------------
COMPANY_NAME="NexGen AI Corp"
COMPANY_MISSION="Autonomously generate revenue through AI-powered content and commerce"

# How long between company reporting cycles (minutes)
CYCLE_INTERVAL_MINUTES=60

# Minimum confidence score (0.0-1.0) for research to approve a strategy
MIN_RESEARCH_CONFIDENCE=0.70

# LLM model assignments
EXECUTIVE_MODEL=gemini-2.0-flash
RESEARCH_MODEL=gemini-2.0-flash
WORKER_MODEL=gemini-2.0-flash

# Agent heartbeat interval (seconds)
HEARTBEAT_INTERVAL=30

# Max API cost per cycle per department (USD estimate)
MAX_COST_PER_CYCLE=2.00

# ---- Dry Run Mode -------------------------------------
# Set to "true" to run without making real API calls (uses mock responses)
DRY_RUN=false

# ---- Logging -------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=output/company.log
